<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Local emulator tests seed and delete their own Health Connect records. Never in Release. -->
    <uses-permission android:name="android.permission.health.WRITE_STEPS" />
    <uses-permission android:name="android.permission.health.WRITE_SLEEP" />
    <uses-permission android:name="android.permission.health.WRITE_HEART_RATE" />
    <uses-permission android:name="android.permission.health.WRITE_HEART_RATE_VARIABILITY" />
    <application android:networkSecurityConfig="@xml/local_checks_network">
        <activity android:name=".device.TouchProbeActivity" android:exported="false" />
        <activity android:name=".ui.LayoutProbeActivity" android:exported="false" />
        <!-- Fixture packages must not reconnect a persisted test address automatically after boot. -->
        <receiver android:name=".device.BootReceiver" android:enabled="false" />
    </application>
</manifest>
