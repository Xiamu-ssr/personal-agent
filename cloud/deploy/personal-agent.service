[Unit]
Description=Personal Agent cloud body
After=network-online.target mihomo.service personal-agent-browser.service
Wants=network-online.target personal-agent-browser.service

[Service]
Type=simple
User=agent
Group=agent
WorkingDirectory=/srv/agent
EnvironmentFile=/etc/personal-agent.env
Environment=AGENT_BROWSER_SERVICE=personal-agent-browser.service
ExecStart=/usr/bin/node /opt/personal-agent/cloud/src/main.mjs
Restart=always
RestartSec=5
# The agent may write anywhere it owns (/srv/agent, /home/agent, /tmp); the rest of the OS is read-only to it.
ProtectSystem=full
NoNewPrivileges=true
MemoryAccounting=true
MemoryLimit=900M
MemoryMax=900M

[Install]
WantedBy=multi-user.target
