[Unit]
Description=Personal Agent artifact thumbnail %i
CollectMode=inactive-or-failed

[Service]
Type=oneshot
WorkingDirectory=/srv/agent
Environment=AGENT_ROOT=/srv/agent
ExecStart=/usr/bin/node /opt/personal-agent/cloud/src/screenshot-host.mjs %i
Slice=personal-agent-browser.slice
Restart=no
KillMode=control-group
TimeoutStartSec=28
TimeoutStopSec=3
UMask=0077
NoNewPrivileges=true
MemoryMax=450M
MemorySwapMax=0
OOMPolicy=kill
TasksMax=384
