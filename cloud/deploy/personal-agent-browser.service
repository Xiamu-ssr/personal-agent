[Unit]
Description=Personal Agent browser host
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agent
Group=agent
WorkingDirectory=/srv/agent
Environment=AGENT_ROOT=/srv/agent
ExecStart=/usr/bin/node /opt/personal-agent/cloud/src/browser/host.mjs
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=8
UMask=0077
NoNewPrivileges=true
MemoryAccounting=true
MemoryLimit=800M
MemoryMax=800M
TasksMax=384

[Install]
WantedBy=multi-user.target
